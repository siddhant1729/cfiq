# --- PostgreSQL (used by docker-compose and by the Python code) ---
POSTGRES_USER=cfiq
POSTGRES_PASSWORD=cfiq
POSTGRES_DB=cfiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Run knobs (override config/cfiq.yaml) ---
SAMPLE_SIZE=3000
RANDOM_SEED=42
